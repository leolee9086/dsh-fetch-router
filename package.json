{
  "name": "@leolee9086/dsh-fetch-router",
  "version": "0.1.1",
  "description": "Route and rewrite the harness's outbound HTTP requests by host and path, with a native right-sidebar monitor.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "files": ["lib", "cordis.patch.yml", "assets"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/leolee9086/dsh-fetch-router.git" },
  "keywords": ["dsh-plugin", "deepseek-harness", "fetch", "router", "header"],
  "dependencies": { "@leolee9086/sac-path-router": "^0.1.0" },
  "scripts": { "test": "node --test" }
